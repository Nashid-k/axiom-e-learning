# Axiom E-Learning OS Environment Template

# 1. Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/axiom_db?retryWrites=true&w=majority

# 2. Artificial Intelligence Engine (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. High Performance Cache (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# 4. Next Authentication (NextAuth Credentials & Providers)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_jwt_secret_key_here

# 5. Developer Port Settings
PORT=3000
